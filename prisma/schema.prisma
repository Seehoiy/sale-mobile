generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  address        String?
  phone          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  branchStocks   BranchStock[]
  claimRequests  ClaimRequest[]
  employees      Employee[]
  inventoryItems InventoryItem[] @relation("CurrentBranch")
  purchaseOrders PurchaseOrder[]
  repairJobs     RepairJob[]
  sales          Sale[]
  transfersOut   StockTransfer[] @relation("TransferFromBranch")
  transfersIn    StockTransfer[] @relation("TransferToBranch")
  tradeIns       TradeIn[]

  @@map("branches")
}

model Employee {
  id             String          @id @default(cuid())
  empCode        String          @unique
  pinCode        String          @default("1234")
  username       String          @unique
  passwordHash   String
  fullName       String
  role           EmployeeRole
  branchId       String
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  branch         Branch          @relation(fields: [branchId], references: [id])
  imeiHistories  ImeiHistory[]   @relation("HistoryActor")
  purchaseOrders PurchaseOrder[]
  repairJobsTech RepairJob[]     @relation("RepairTechnician")
  sales          Sale[]
  tradeIns       TradeIn[]       @relation("TradeInEvaluator")

  @@index([branchId, isActive])
  @@map("employees")
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]

  @@map("brands")
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id                 String              @id @default(cuid())
  sku                String              @unique
  name               String
  brandId            String?
  categoryId         String
  trackingType       TrackingType        @default(SERIALIZED)
  attributes         Json?
  costPrice          Decimal             @db.Decimal(12, 2)
  sellPrice          Decimal             @db.Decimal(12, 2)
  images             String[]
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  branchStocks       BranchStock[]
  inventoryItems     InventoryItem[]
  brand              Brand?              @relation(fields: [brandId], references: [id])
  category           Category            @relation(fields: [categoryId], references: [id])
  purchaseOrderItems PurchaseOrderItem[]
  repairJobParts     RepairJobPart[]
  saleItems          SaleItem[]
  stockTransferItems StockTransferItem[]

  @@index([brandId])
  @@index([categoryId])
  @@map("products")
}

model BranchStock {
  id           String   @id @default(cuid())
  branchId     String
  productId    String
  quantity     Int      @default(0)
  reorderLevel Int      @default(0)
  updatedAt    DateTime @updatedAt
  branch       Branch   @relation(fields: [branchId], references: [id])
  product      Product  @relation(fields: [productId], references: [id])

  @@unique([branchId, productId])
  @@map("branch_stocks")
}

model InventoryItem {
  id                  String              @id @default(cuid())
  imei1               String              @unique
  imei2               String?             @unique
  serialNumber        String?             @unique
  productId           String
  currentBranchId     String
  status              ImeiStatus          @default(IN_STOCK)
  condition           ItemCondition       @default(NEW)
  costPrice           Decimal             @db.Decimal(12, 2)
  sourceType          String              @default("PURCHASE")
  purchaseOrderItemId String?             @unique
  tradeInId           String?             @unique
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  claimRequests       ClaimRequest[]      @relation("ClaimedItem")
  claimSwappedFor     ClaimRequest?       @relation("SwappedNewItem")
  history             ImeiHistory[]
  currentBranch       Branch              @relation("CurrentBranch", fields: [currentBranchId], references: [id])
  product             Product             @relation(fields: [productId], references: [id])
  purchaseOrderItem   PurchaseOrderItem?  @relation(fields: [purchaseOrderItemId], references: [id])
  tradeIn             TradeIn?            @relation(fields: [tradeInId], references: [id])
  repairJobs          RepairJob[]
  saleItem            SaleItem?
  stockTransferItems  StockTransferItem[]
  warranty            Warranty?

  // ⚡ DB INDEX OPTIMIZATION: ເພີ່ມ composite index ເພື່ອເລັ່ງຄວາມໄວໃນການ Filter & Query ສາງ IMEI
  @@index([currentBranchId, status])
  @@index([productId, currentBranchId, status])
  @@map("inventory_items")
}

model ImeiHistory {
  id              String        @id @default(cuid())
  inventoryItemId String
  eventType       ImeiEventType
  fromBranchId    String?
  toBranchId      String?
  note            String?
  refType         String?
  refId           String?
  actorId         String?
  createdAt       DateTime      @default(now())
  actor           Employee?     @relation("HistoryActor", fields: [actorId], references: [id])
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  // ⚡ DB INDEX OPTIMIZATION: ເພີ່ມ index ສຳລັບດຶງປະຫວັດຕາມ IMEI ແລະ ວັນທີ
  @@index([inventoryItemId])
  @@index([inventoryItemId, createdAt])
  @@map("imei_history")
}

model Supplier {
  id      String          @id @default(cuid())
  name    String
  phone   String?
  address String?
  orders  PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  poNumber   String              @unique
  supplierId String?
  branchId   String
  employeeId String
  status     PurchaseOrderStatus @default(DRAFT)
  orderDate  DateTime            @default(now())
  receivedAt DateTime?
  items      PurchaseOrderItem[]
  branch     Branch              @relation(fields: [branchId], references: [id])
  employee   Employee            @relation(fields: [employeeId], references: [id])
  supplier   Supplier?           @relation(fields: [supplierId], references: [id])

  @@index([branchId, orderDate])
  @@index([employeeId, orderDate])
  @@index([supplierId, orderDate])
  @@index([status, orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String         @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  costPrice       Decimal        @db.Decimal(12, 2)
  inventoryItem   InventoryItem[]
  product         Product        @relation(fields: [productId], references: [id])
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model StockTransfer {
  id           String              @id @default(cuid())
  transferNo   String              @unique
  fromBranchId String
  toBranchId   String
  status       TransferStatus      @default(PENDING)
  requestedAt  DateTime            @default(now())
  receivedAt   DateTime?
  items        StockTransferItem[]
  fromBranch   Branch              @relation("TransferFromBranch", fields: [fromBranchId], references: [id])
  toBranch     Branch              @relation("TransferToBranch", fields: [toBranchId], references: [id])

  @@map("stock_transfers")
}

model StockTransferItem {
  id              String         @id @default(cuid())
  transferId      String
  inventoryItemId String?
  productId       String?
  quantity        Int?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  product         Product?       @relation(fields: [productId], references: [id])
  transfer        StockTransfer  @relation(fields: [transferId], references: [id])

  @@map("stock_transfer_items")
}

model Customer {
  id            String         @id @default(cuid())
  fullName      String
  phone         String?        @unique
  idCardNumber  String?
  idCardImage   String?
  address       String?
  createdAt     DateTime       @default(now())
  claimRequests ClaimRequest[]
  repairJobs    RepairJob[]
  sales         Sale[]
  tradeIns      TradeIn[]

  @@map("customers")
}

model Sale {
  id            String     @id @default(cuid())
  billNo        String     @unique
  totalAmout    Float
  invoiceNo     String     @unique
  branchId      String
  customerId    String?
  employeeId    String
  subtotal      Decimal    @db.Decimal(12, 2)
  discount      Decimal    @default(0) @db.Decimal(12, 2)
  tradeInOffset Decimal    @default(0) @db.Decimal(12, 2)
  total         Decimal    @db.Decimal(12, 2)
  status        SaleStatus @default(COMPLETED)
  createdAt     DateTime   @default(now())
  payments      Payment[]
  items         SaleItem[]
  branch        Branch     @relation(fields: [branchId], references: [id])
  customer      Customer?  @relation(fields: [customerId], references: [id])
  employee      Employee   @relation(fields: [employeeId], references: [id])
  tradeInUsed   TradeIn?   @relation("TradeInAppliedToSale")

  @@index([branchId, createdAt])
  @@index([employeeId, createdAt])
  @@index([customerId])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id              String         @id @default(cuid())
  saleId          String
  productId       String
  inventoryItemId String?        @unique
  quantity        Int            @default(1)
  unitPrice       Decimal        @db.Decimal(12, 2)
  discount        Decimal        @default(0) @db.Decimal(12, 2)
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  product         Product        @relation(fields: [productId], references: [id])
  sale            Sale           @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Payment {
  id     String        @id @default(cuid())
  saleId String
  method PaymentMethod
  amount Decimal       @db.Decimal(12, 2)
  refNo  String?
  paidAt DateTime      @default(now())
  sale   Sale          @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@map("payments")
}

model TradeIn {
  id                  String         @id @default(cuid())
  tradeInNo           String         @unique
  branchId            String
  customerId          String
  employeeId          String
  deviceDescription   String
  imeiInput           String?
  batteryHealth       Int?
  screenCondition     String?
  bodyCondition       String?
  accessoriesIncluded String[]
  conditionImages     String[]
  idCardImageFront    String
  idCardImageBack     String?
  customerPhoto       String
  offeredPrice        Decimal        @db.Decimal(12, 2)
  status              TradeInStatus  @default(EVALUATED)
  createdAt           DateTime       @default(now())
  appliedSaleId       String?        @unique
  resultInventoryItem InventoryItem?
  appliedSale         Sale?          @relation("TradeInAppliedToSale", fields: [appliedSaleId], references: [id])
  branch              Branch         @relation(fields: [branchId], references: [id])
  customer            Customer       @relation(fields: [customerId], references: [id])
  employee            Employee       @relation("TradeInEvaluator", fields: [employeeId], references: [id])

  @@map("trade_ins")
}

model RepairJob {
  id                String          @id @default(cuid())
  ticketNo          String          @unique
  branchId          String
  customerId        String
  inventoryItemId   String?
  imeiInput         String?
  deviceDescription String
  passcode          String?
  issueDescription  String
  conditionImages   String[]
  status            RepairStatus    @default(PENDING)
  estimatedCost     Decimal?        @db.Decimal(12, 2)
  finalCost         Decimal?        @db.Decimal(12, 2)
  technicianId      String?
  receivedAt        DateTime        @default(now())
  deliveredAt       DateTime?
  parts             RepairJobPart[]
  branch            Branch          @relation(fields: [branchId], references: [id])
  customer          Customer        @relation(fields: [customerId], references: [id])
  inventoryItem     InventoryItem?  @relation(fields: [inventoryItemId], references: [id])
  technician        Employee?       @relation("RepairTechnician", fields: [technicianId], references: [id])

  @@index([customerId, receivedAt])
  @@index([status, receivedAt])
  @@map("repair_jobs")
}

model RepairJobPart {
  id          String    @id @default(cuid())
  repairJobId String
  productId   String
  quantity    Int       @default(1)
  cost        Decimal   @db.Decimal(12, 2)
  product     Product   @relation(fields: [productId], references: [id])
  repairJob   RepairJob @relation(fields: [repairJobId], references: [id])

  @@index([repairJobId])
  @@index([productId])
  @@map("repair_job_parts")
}

model Warranty {
  id              String         @id @default(cuid())
  inventoryItemId String         @unique
  type            WarrantyType
  startDate       DateTime
  endDate         DateTime
  durationMonths  Int
  terms           String?
  createdAt       DateTime       @default(now())
  claims          ClaimRequest[]
  inventoryItem   InventoryItem  @relation(fields: [inventoryItemId], references: [id])

  @@map("warranties")
}

model ClaimRequest {
  id               String         @id @default(cuid())
  claimNo          String         @unique
  warrantyId       String?
  inventoryItemId  String
  customerId       String
  branchId         String
  issueDescription String
  status           ClaimStatus    @default(RECEIVED)
  swappedNewItemId String?        @unique
  sentAt           DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime       @default(now())
  branch           Branch         @relation(fields: [branchId], references: [id])
  customer         Customer       @relation(fields: [customerId], references: [id])
  inventoryItem    InventoryItem  @relation("ClaimedItem", fields: [inventoryItemId], references: [id])
  swappedNewItem   InventoryItem? @relation("SwappedNewItem", fields: [swappedNewItemId], references: [id])
  warranty         Warranty?      @relation(fields: [warrantyId], references: [id])

  @@index([branchId, status])
  @@index([customerId, createdAt])
  @@index([warrantyId, status])
  @@index([status, createdAt])
  @@index([inventoryItemId])
  @@map("claim_requests")
}

enum EmployeeRole {
  ADMIN
  MANAGER
  CASHIER
  TECHNICIAN
  WAREHOUSE
}

enum TrackingType {
  SERIALIZED
  QUANTITY
}

enum ImeiStatus {
  IN_STOCK
  RESERVED
  TRANSFER_OUT
  IN_TRANSIT
  SOLD
  IN_REPAIR
  CLAIMED_OUT
  SECOND_HAND
  DAMAGED

  @@map("imei_status")
}

enum ItemCondition {
  NEW
  USED_LIKE_NEW
  USED_GOOD
  USED_FAIR
  DAMAGED
}

enum ImeiEventType {
  PURCHASE_IN
  TRANSFER_OUT
  TRANSFER_IN
  SALE
  RETURN_FROM_CUSTOMER
  TRADE_IN_RECEIVED
  REPAIR_IN
  REPAIR_OUT
  CLAIM_SENT
  CLAIM_RETURNED
  CLAIM_SWAPPED
  STATUS_ADJUSTED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum SaleStatus {
  COMPLETED
  REFUNDED
  VOIDED
}

enum PaymentMethod {
  CASH
  BCEL_ONE_QR
  BANK_TRANSFER
  CARD
}

enum TradeInStatus {
  EVALUATED
  ACCEPTED
  REJECTED
  CONVERTED_TO_STOCK
}

enum RepairStatus {
  PENDING
  IN_PROGRESS
  WAITING_FOR_PARTS
  DONE
  DELIVERED
  CANCELLED
}

enum WarrantyType {
  BRAND
  STORE
}

enum ClaimStatus {
  RECEIVED
  SENT_TO_CENTER
  REPAIRED_RETURNED
  SWAPPED
  RETURNED_TO_CUSTOMER
  REJECTED
}
