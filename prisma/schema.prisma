
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 1. CORE: ອົງກອນ / ສາຂາ / ຜູ້ໃຊ້ງານ
// ============================================================================

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique // ຕົວຫຍໍ້ສາຂາ ເຊັ່ນ VTE-01
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees        Employee[]
  branchStocks     BranchStock[]
  inventoryItems   InventoryItem[]        @relation("CurrentBranch")
  purchaseOrders   PurchaseOrder[]
  sales            Sale[]
  tradeIns         TradeIn[]
  repairJobs       RepairJob[]
  claimRequests    ClaimRequest[]
  transfersOut     StockTransfer[]        @relation("TransferFromBranch")
  transfersIn      StockTransfer[]        @relation("TransferToBranch")

  @@map("branches")
}

enum EmployeeRole {
  ADMIN
  MANAGER
  CASHIER
  TECHNICIAN
  WAREHOUSE
}

model Employee {
  id           String       @id @default(cuid())

  empCode      String       @unique
  pinCode      String       @default("1234")     
  username     String       @unique
  passwordHash String
  fullName     String
  role         EmployeeRole
  branchId     String
  branch       Branch       @relation(fields: [branchId], references: [id])
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  sales           Sale[]
  purchaseOrders  PurchaseOrder[]
  tradeIns        TradeIn[]         @relation("TradeInEvaluator")
  repairJobsTech  RepairJob[]       @relation("RepairTechnician")
  imeiHistories   ImeiHistory[]     @relation("HistoryActor")

  @@map("employees")
}

// ============================================================================
// 2. ສິນຄ້າ / ໝວດໝູ່ / ຍີ່ຫໍ້
// ============================================================================

enum TrackingType {
  SERIALIZED // ຕິດຕາມແຍກ IMEI (ໂທລະສັບ, ແທັບເລັດ)
  QUANTITY   // ຕິດຕາມແບບນັບຈຳນວນ (ອຸປະກອນເສີມ, ອາໄຫຼ່)
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]

  @@map("brands")
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique // ໂທລະສັບ, ອຸປະກອນເສີມ, ອາໄຫຼ່
  products Product[]

  @@map("categories")
}

model Product {
  id            String       @id @default(cuid())
  sku           String       @unique
  name          String       // ເຊັ່ນ: iPhone 15 Pro Max 256GB Natural Titanium
  brandId       String?
  brand         Brand?       @relation(fields: [brandId], references: [id])
  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id])
  trackingType  TrackingType @default(SERIALIZED)

  // ຄຸນສົມບັດ variant (ສີ, ຄວາມຈຸ) — ເກັບແບບ flexible json
  attributes    Json?        // { "storage": "256GB", "color": "Natural Titanium" }

  costPrice     Decimal      @db.Decimal(12, 2)
  sellPrice     Decimal      @db.Decimal(12, 2)
  images        String[]
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  inventoryItems      InventoryItem[]
  branchStocks        BranchStock[]
  purchaseOrderItems  PurchaseOrderItem[]
  saleItems           SaleItem[]
  repairJobParts      RepairJobPart[]
  stockTransferItems  StockTransferItem[]

  @@map("products")
}

// ສະຕັອກແບບນັບຈຳນວນ (ອຸປະກອນເສີມ/ອາໄຫຼ່) ແຍກຕາມສາຂາ
model BranchStock {
  id            String   @id @default(cuid())
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id])
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  quantity      Int      @default(0)
  reorderLevel  Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([branchId, productId])
  @@map("branch_stocks")
}

// ============================================================================
// 3. IMEI / SERIAL TRACKING — ຫົວໃຈຫຼັກ
// ============================================================================

enum ImeiStatus {
  IN_STOCK      // ຢູ່ໃນສາງ ພ້ອມຂາຍ
  RESERVED      // ຈອງແລ້ວ
  TRANSFER_OUT  // ກຳລັງໂອນອອກ
  IN_TRANSIT    // ຢູ່ລະຫວ່າງທາງໂອນຍ້າຍ
  SOLD          // ຂາຍອອກແລ້ວ
  IN_REPAIR     // ຢູ່ໃນຂັ້ນຕອນຊ່ອມ
  CLAIMED_OUT   // ສົ່ງເຄລມໄປສູນ/ຮ້ານໃຫຍ່
  SECOND_HAND   // ຮັບເທິນມາ ລໍຖ້າຂາຍຕໍ່
  DAMAGED       // ເສຍ/ຕັດສະຕັອກ

  @@map("imei_status")
}

enum ItemCondition {
  NEW
  USED_LIKE_NEW
  USED_GOOD
  USED_FAIR
  DAMAGED
}

model InventoryItem {
  id             String        @id @default(cuid())
  imei1          String        @unique
  imei2          String?       @unique // ຮອງຮັບເຄື່ອງ Dual SIM
  serialNumber   String?       @unique

  productId      String
  product        Product       @relation(fields: [productId], references: [id])

  currentBranchId String
  currentBranch   Branch       @relation("CurrentBranch", fields: [currentBranchId], references: [id])

  status         ImeiStatus    @default(IN_STOCK)
  condition      ItemCondition @default(NEW)

  costPrice      Decimal       @db.Decimal(12, 2) // ຕົ້ນທຶນ (ອາດແຕກຕ່າງກັນຕໍ່ IMEI ຖ້າມາຈາກ trade-in)

  // ແຫຼ່ງທີ່ມາ
  sourceType     String        @default("PURCHASE") // PURCHASE | TRADE_IN
  purchaseOrderItemId String?  @unique
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  tradeInId      String?       @unique
  tradeIn        TradeIn?      @relation(fields: [tradeInId], references: [id])

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  history            ImeiHistory[]
  warranty           Warranty?
  saleItem           SaleItem?
  repairJobs         RepairJob[]
  claimRequests      ClaimRequest[]        @relation("ClaimedItem")
  claimSwappedFor    ClaimRequest[]        @relation("SwappedNewItem")
  stockTransferItems StockTransferItem[]

  @@index([currentBranchId, status])
  @@map("inventory_items")
}

enum ImeiEventType {
  PURCHASE_IN
  TRANSFER_OUT
  TRANSFER_IN
  SALE
  RETURN_FROM_CUSTOMER
  TRADE_IN_RECEIVED
  REPAIR_IN
  REPAIR_OUT
  CLAIM_SENT
  CLAIM_RETURNED
  CLAIM_SWAPPED
  STATUS_ADJUSTED
}

// ປະຫວັດເຕັມຮູບແບບຂອງແຕ່ລະ IMEI — audit trail
model ImeiHistory {
  id              String        @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  eventType       ImeiEventType
  fromBranchId    String?
  toBranchId      String?
  note            String?
  refType         String?       // "Sale" | "StockTransfer" | "RepairJob" | "ClaimRequest" | "TradeIn"
  refId           String?
  actorId         String?
  actor           Employee?     @relation("HistoryActor", fields: [actorId], references: [id])
  createdAt       DateTime      @default(now())

  @@index([inventoryItemId])
  @@map("imei_history")
}

// ============================================================================
// 4. ນຳເຂົ້າ (PURCHASE ORDER)
// ============================================================================

model Supplier {
  id       String          @id @default(cuid())
  name     String
  phone    String?
  address  String?
  orders   PurchaseOrder[]

  @@map("suppliers")
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  poNumber    String              @unique
  supplierId  String?
  supplier    Supplier?           @relation(fields: [supplierId], references: [id])
  branchId    String
  branch      Branch              @relation(fields: [branchId], references: [id])
  employeeId  String
  employee    Employee            @relation(fields: [employeeId], references: [id])
  status      PurchaseOrderStatus @default(DRAFT)
  orderDate   DateTime            @default(now())
  receivedAt  DateTime?

  items PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  costPrice       Decimal       @db.Decimal(12, 2)

  // ຖ້າ product ເປັນ SERIALIZED, ແຕ່ລະ item ຈະຖືກສ້າງເປັນ InventoryItem (1 ຕໍ່ 1 IMEI)
  inventoryItem   InventoryItem?

  @@map("purchase_order_items")
}

// ============================================================================
// 5. ໂອນຍ້າຍສາຂາ (STOCK TRANSFER)
// ============================================================================

enum TransferStatus {
  PENDING
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model StockTransfer {
  id           String          @id @default(cuid())
  transferNo   String          @unique
  fromBranchId String
  fromBranch   Branch          @relation("TransferFromBranch", fields: [fromBranchId], references: [id])
  toBranchId   String
  toBranch     Branch          @relation("TransferToBranch", fields: [toBranchId], references: [id])
  status       TransferStatus  @default(PENDING)
  requestedAt  DateTime        @default(now())
  receivedAt   DateTime?

  items StockTransferItem[]

  @@map("stock_transfers")
}

model StockTransferItem {
  id              String         @id @default(cuid())
  transferId      String
  transfer        StockTransfer  @relation(fields: [transferId], references: [id])

  // ສຳລັບ SERIALIZED (IMEI)
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  // ສຳລັບ QUANTITY (ອຸປະກອນເສີມ/ອາໄຫຼ່)
  productId       String?
  product         Product?       @relation(fields: [productId], references: [id])
  quantity        Int?

  @@map("stock_transfer_items")
}

// ============================================================================
// 6. ລູກຄ້າ
// ============================================================================

model Customer {
  id            String   @id @default(cuid())
  fullName      String
  phone         String?  @unique
  idCardNumber  String?
  idCardImage   String?
  address       String?
  createdAt     DateTime @default(now())

  sales         Sale[]
  tradeIns      TradeIn[]
  repairJobs    RepairJob[]
  claimRequests ClaimRequest[]

  @@map("customers")
}

// ============================================================================
// 7. ຂາຍ / POS (SALES FLOW)
// ============================================================================

enum SaleStatus {
  COMPLETED
  REFUNDED
  VOIDED
}

model Sale {
  id             String     @id @default(cuid())

  billNo         String     @unique
  totalAmout     Float
  
  invoiceNo      String     @unique
  branchId       String
  branch         Branch     @relation(fields: [branchId], references: [id])
  customerId     String?
  customer       Customer?  @relation(fields: [customerId], references: [id])
  employeeId     String
  employee       Employee   @relation(fields: [employeeId], references: [id])

  subtotal       Decimal    @db.Decimal(12, 2)
  discount       Decimal    @db.Decimal(12, 2) @default(0)
  tradeInOffset  Decimal    @db.Decimal(12, 2) @default(0) // ສ່ວນຫຼຸດຈາກຮັບເທິນເຄື່ອງເກົ່າ
  total          Decimal    @db.Decimal(12, 2)
  status         SaleStatus @default(COMPLETED)
  createdAt      DateTime   @default(now())

  items          SaleItem[]
  payments       Payment[]
  tradeInUsed    TradeIn?   @relation("TradeInAppliedToSale")

  @@map("sales")
}

model SaleItem {
  id              String        @id @default(cuid())
  saleId          String
  sale            Sale          @relation(fields: [saleId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])

  // ຖ້າ product ເປັນ SERIALIZED — ຜູກກັບ IMEI ໂດຍກົງ (1 ຕໍ່ 1)
  inventoryItemId String?       @unique
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  quantity        Int           @default(1) // ໃຊ້ກັບ QUANTITY-tracked (ອຸປະກອນເສີມ)
  unitPrice       Decimal       @db.Decimal(12, 2)
  discount        Decimal       @db.Decimal(12, 2) @default(0)

  @@map("sale_items")
}

enum PaymentMethod {
  CASH
  BCEL_ONE_QR
  BANK_TRANSFER
  CARD
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String
  sale      Sale          @relation(fields: [saleId], references: [id])
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  refNo     String?
  paidAt    DateTime      @default(now())

  @@map("payments")
}

// ============================================================================
// 8. ຮັບເທິນ / ຮັບຊື້ເຄື່ອງເກົ່າ (TRADE-IN)
// ============================================================================

enum TradeInStatus {
  EVALUATED
  ACCEPTED
  REJECTED
  CONVERTED_TO_STOCK // ສ້າງເປັນ InventoryItem second-hand ແລ້ວ
}

model TradeIn {
  id                 String        @id @default(cuid())
  tradeInNo          String        @unique
  branchId           String
  branch             Branch        @relation(fields: [branchId], references: [id])
  customerId         String
  customer           Customer      @relation(fields: [customerId], references: [id])
  employeeId         String
  employee           Employee      @relation("TradeInEvaluator", fields: [employeeId], references: [id])

  // ຂໍ້ມູນເຄື່ອງທີ່ນຳມາເທິນ
  deviceDescription  String        // ຮຸ່ນ/ສີ ທີ່ພະນັກງານພິມເອງ (ອາດຍັງບໍ່ມີໃນລະບົບ)
  imeiInput          String?
  batteryHealth      Int?          // %
  screenCondition    String?
  bodyCondition      String?
  accessoriesIncluded String[]     // ["ສາຍສາກ", "ກ່ອງ"]
  conditionImages    String[]

  // KYC / Security check
  idCardImageFront   String
  idCardImageBack    String?
  customerPhoto      String

  offeredPrice       Decimal       @db.Decimal(12, 2)
  status             TradeInStatus @default(EVALUATED)
  createdAt          DateTime      @default(now())

  // ຜົນຂອງການເທິນ: ກາຍເປັນ IMEI ໃໝ່ໃນສະຕັອກ second-hand
  resultInventoryItem InventoryItem?

  // ຖ້ານຳໄປຫັກເປັນສ່ວນຫຼຸດໃນບິນຊື້ໃໝ່ທັນທີ
  appliedSaleId      String?       @unique
  appliedSale        Sale?         @relation("TradeInAppliedToSale", fields: [appliedSaleId], references: [id])

  @@map("trade_ins")
}

// ============================================================================
// 9. ຮັບຊ່ອມ / ຕິດຕາມງານຊ່ອມ (SERVICE & REPAIR)
// ============================================================================

enum RepairStatus {
  PENDING
  IN_PROGRESS
  WAITING_FOR_PARTS
  DONE
  DELIVERED
  CANCELLED
}

model RepairJob {
  id                String        @id @default(cuid())
  ticketNo          String        @unique
  branchId          String
  branch            Branch        @relation(fields: [branchId], references: [id])
  customerId        String
  customer          Customer      @relation(fields: [customerId], references: [id])

  // ຖ້າເຄື່ອງມີໃນລະບົບ (ຂາຍໂດຍຮ້ານເອງ) ຜູກກັບ IMEI ໂດຍກົງ
  inventoryItemId   String?
  inventoryItem     InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  imeiInput         String?        // ຖ້າເຄື່ອງບໍ່ໄດ້ຢູ່ໃນລະບົບ

  deviceDescription String
  passcode          String?        // Passcode/Pattern lock
  issueDescription  String
  conditionImages   String[]

  status            RepairStatus  @default(PENDING)
  estimatedCost     Decimal?      @db.Decimal(12, 2)
  finalCost         Decimal?      @db.Decimal(12, 2)

  technicianId      String?
  technician        Employee?     @relation("RepairTechnician", fields: [technicianId], references: [id])

  receivedAt        DateTime      @default(now())
  deliveredAt       DateTime?

  parts             RepairJobPart[]

  @@map("repair_jobs")
}

// ເບີກອາໄຫຼ່ຈາກສະຕັອກ POS ມາໃຊ້ໃນງານຊ່ອມ
model RepairJobPart {
  id          String   @id @default(cuid())
  repairJobId String
  repairJob   RepairJob @relation(fields: [repairJobId], references: [id])
  productId   String    // ອາໄຫຼ່: ຈໍ, ແບັດເຕີຣີ, IC (QUANTITY-tracked product)
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Int       @default(1)
  cost        Decimal   @db.Decimal(12, 2)

  @@map("repair_job_parts")
}

// ============================================================================
// 10. ປະກັນ ແລະ ເຄລມ (WARRANTY & CLAIM)
// ============================================================================

enum WarrantyType {
  BRAND // ປະກັນສູນ
  STORE // ປະກັນຮ້ານ
}

model Warranty {
  id              String       @id @default(cuid())
  inventoryItemId String       @unique
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  type            WarrantyType
  startDate       DateTime
  endDate         DateTime
  durationMonths  Int
  terms           String?
  createdAt       DateTime     @default(now())

  claims          ClaimRequest[]

  @@map("warranties")
}

enum ClaimStatus {
  RECEIVED
  SENT_TO_CENTER
  REPAIRED_RETURNED
  SWAPPED
  RETURNED_TO_CUSTOMER
  REJECTED
}

model ClaimRequest {
  id                  String       @id @default(cuid())
  claimNo             String       @unique
  warrantyId          String?
  warranty            Warranty?    @relation(fields: [warrantyId], references: [id])

  inventoryItemId     String
  inventoryItem       InventoryItem @relation("ClaimedItem", fields: [inventoryItemId], references: [id])

  customerId          String
  customer            Customer     @relation(fields: [customerId], references: [id])
  branchId            String
  branch              Branch       @relation(fields: [branchId], references: [id])

  issueDescription    String
  status              ClaimStatus  @default(RECEIVED)

  // ຖ້າມີການປ່ຽນເຄື່ອງໃໝ່ (Swap IMEI)
  swappedNewItemId    String?      @unique
  swappedNewItem      InventoryItem? @relation("SwappedNewItem", fields: [swappedNewItemId], references: [id])

  sentAt              DateTime?
  resolvedAt          DateTime?
  createdAt           DateTime     @default(now())

  @@map("claim_requests")
}
